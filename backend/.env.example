PORT=5000
GITHUB_PAT=your_personal_access_token_here
GITHUB_REPO=your_org_or_username/your_repo_name_here
DATABASE_FILE=teamsync.db
# Client app integrations (comma separated list of secrets for webhook auth or similar)
INBOUND_WEBHOOK_SECRET=default_webhook_secret_key

# Set to true to bypass automatic database seeding of fake users and repositories
SKIP_SEED=true
